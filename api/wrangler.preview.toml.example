name = "replace-with-preview-worker-name"
main = "src/index.ts"
compatibility_date = "2026-04-12"

# Copy this file to wrangler.preview.toml, which is ignored by git. Keep every
# real resource coordinate in that ignored copy only.
[vars]
ENVIRONMENT = "preview"
ALLOW_ADMIN_BOOTSTRAP = "false"
ALLOWED_ORIGINS = "https://preview-pages.example.invalid"
SESSION_SAME_SITE = "lax"

[triggers]
crons = ["17 3 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "replace-with-preview-d1-name"
database_id = "00000000-0000-0000-0000-000000000000"

[[r2_buckets]]
binding = "MEDIA_BUCKET"
bucket_name = "replace-with-preview-r2-bucket"

[[ratelimits]]
name = "ANALYTICS_RATE_LIMITER"
namespace_id = "900000001"
simple = { limit = 6, period = 60 }

[[ratelimits]]
name = "LOGIN_RATE_LIMITER"
namespace_id = "900000002"
simple = { limit = 5, period = 60 }

# Required Worker secrets are injected with `wrangler secret put` using this
# exact config path. Never add secret values to this file.
# - SESSION_SECRET
# - PROXY_SHARED_SECRET (same value as the Pages Preview secret)
